@using Evaluation.Web.Services
@inject AuthState Auth

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">VUC Fyn</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Dashboard
            </NavLink>
        </div>

        @if (Auth.ActiveRole == "Admin")
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="">
                    <span class="bi bi-people-fill" aria-hidden="true"></span> Users
                </NavLink>
            </div>
        }

        @if (Auth.ActiveRole == "Teacher")
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="">
                    <span class="bi bi-question-circle-fill" aria-hidden="true"></span> Questions
                </NavLink>
            </div>
        }

        @if (Auth.ActiveRole == "Student")
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="">
                    <span class="bi bi-book-fill" aria-hidden="true"></span> My Questions
                </NavLink>
            </div>
        }
    </nav>
</div>

