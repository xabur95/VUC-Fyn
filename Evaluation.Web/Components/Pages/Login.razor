@page "/login"
@layout Evaluation.Web.Components.Layout.EmptyLayout
@using Evaluation.Web.Services
@inject ApiClient Api
@inject AuthState Auth
@inject NavigationManager Nav

<div class="d-flex justify-content-center align-items-center vh-100">
    <div class="card shadow" style="min-width: 400px;">
        <div class="card-body">
            <h3 class="card-title text-center mb-4">🔑 Login</h3>

            @if (!string.IsNullOrEmpty(_error))
            {
                <div class="alert alert-danger">@_error</div>
            }

            <div class="mb-3">
                <label class="form-label">Email</label>
                <input type="email" class="form-control" @bind="_email" placeholder="Enter your email" />
            </div>

            <div class="mb-3">
                <label class="form-label">Password</label>
                <input type="password" class="form-control" @bind="_password" placeholder="Enter your password" />
            </div>

            <button class="btn btn-primary w-100" @onclick="LoginAsync" disabled="@_loading">
                @if (_loading)
                {
                    <span class="spinner-border spinner-border-sm me-1"></span>
                }
                Login
            </button>
        </div>
    </div>
</div>

@code {
    private string _email = "";
    private string _password = "";
    private string? _error;
    private bool _loading;

    private async Task LoginAsync()
    {
        _error = null;
        _loading = true;

        try
        {
            if (string.IsNullOrWhiteSpace(_email) || string.IsNullOrWhiteSpace(_password))
            {
                _error = "Please enter both email and password.";
                return;
            }

            var user = await Api.LoginAsync(_email, _password);
            if (user is null)
            {
                _error = "Login failed.";
                return;
            }

            Auth.Login(user);

            if (user.Roles.Count() > 1)
                Nav.NavigateTo("/select-role");
            else
                Nav.NavigateTo("/");
        }
        catch (HttpRequestException ex)
        {
            _error = $"Invalid email or password.";
        }
        finally
        {
            _loading = false;
        }
    }
}
