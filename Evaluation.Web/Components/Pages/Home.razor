@page "/"
@using Evaluation.Web.Services
@inject AuthState Auth
@inject NavigationManager Nav

<PageTitle>Dashboard</PageTitle>

@if (!Auth.IsLoggedIn)
{
    <p>Redirecting to login...</p>
}
else if (Auth.ActiveRole is null)
{
    <p>Redirecting to role selection...</p>
}
else if (Auth.ActiveRole == "Admin")
{
    <AdminDashboard />
}
else if (Auth.ActiveRole == "Teacher")
{
    <TeacherDashboard />
}
else if (Auth.ActiveRole == "Student")
{
    <StudentDashboard />
}

@code {
    protected override void OnInitialized()
    {
        if (!Auth.IsLoggedIn)
            Nav.NavigateTo("/login");
        else if (Auth.ActiveRole is null)
            Nav.NavigateTo("/select-role");
    }
}
