@using Semesterprojekt1PBA.Domain.Entities
@using Semesterprojekt1PBA.Frontend.Models

<div class="questions-container">
    <h2>Teacher Question Overview</h2>

    <div class="questions-layout">
        <!-- Left Sidebar -->
        <div class="questions-sidebar">
            <div class="filter-section">
                <h3>Filter</h3>

                <div class="filter-group">
                    <label for="subject">Subject</label>
                    <input type="text" id="subject" class="form-control" @bind="filterModel.Subject" placeholder="Enter subject" />
                </div>

                <div class="filter-group">
                    <label for="tag">Tag</label>
                    <input type="text" id="tag" class="form-control" @bind="filterModel.Tag" placeholder="Enter tag" />
                </div>

                <div class="filter-group">
                    <label for="topic">Topic (Emme)</label>
                    <input type="text" id="topic" class="form-control" @bind="filterModel.Topic" placeholder="Enter topic" />
                </div>

                <div class="filter-group">
                    <label>
                        <input type="checkbox" @bind="filterModel.ShowMyQuestionsOnly" />
                        Show my Questions only
                    </label>
                </div>

                <div class="filter-group">
                    <label for="date">Date</label>
                    <input type="date" id="date" class="form-control" @bind="filterModel.Date" />
                </div>

                <div class="filter-group">
                    <label for="type">Type</label>
                    <input type="text" id="type" class="form-control" @bind="filterModel.Type" placeholder="Enter type" />
                </div>

                <div class="filter-group">
                    <label for="level">Level</label>
                    <select id="level" class="form-control" @bind="filterModel.Level">
                        <option value="">All Levels</option>
                        <option value="A">A</option>
                        <option value="B">B</option>
                        <option value="C">C</option>
                    </select>
                </div>

                <button class="btn btn-primary btn-block" @onclick="ApplyFilters">Apply Filters</button>
                <button class="btn btn-secondary btn-block" @onclick="ClearFilters">Clear Filters</button>
            </div>
        </div>

        <!-- Main Content -->
        <div class="questions-content">
            <div class="questions-list">
                @if (filteredQuestions != null && filteredQuestions.Count > 0)
                {
                    @foreach (var question in filteredQuestions)
                    {
                        <div class="question-card">
                            <div class="question-info">
                                <p class="question-title">
                                    <strong>Question @question.Id:</strong> @question.Subject <span class="level-badge">@question.Level</span> - @question.Topic - @question.Date.ToString("yyyy-MM-dd") - Owner(@question.Owner)
                                </p>
                            </div>
                            <div class="question-actions">
                                <button class="btn btn-edit" @onclick="() => EditQuestion(question.Id)">Edit</button>
                                @if (question.CreatedByUserId == 0)
                                {
                                    <button class="btn btn-delete" @onclick="() => DeleteQuestion(question.Id)">Delete</button>
                                }
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="no-questions">
                        <p>No questions found.</p>
                    </div>
                }
            </div>

            <button class="btn btn-create" @onclick="@(() => ShowCreateQuestionModal = true)">Create New Question</button>
            <Modal Title="Create New Question" Show="ShowCreateQuestionModal" OnClose="CloseCreateQuestionModal">
                <CreateQuestionForm 
                    OnClose="CloseCreateQuestionModal" 
                    OnQuestionCreated="HandleQuestionCreated" 
                    ExistingQuestion="selectedQuestion"/>
            </Modal>
        </div>
    </div>
</div>

@code {
    private bool ShowCreateQuestionModal = false;

    private List<Question>? filteredQuestions;
    private QuestionFilter filterModel = new();
    private Question? selectedQuestion;

    private void CloseCreateQuestionModal()
    {
        ShowCreateQuestionModal = false;
        selectedQuestion = null;
        filteredQuestions = new List<Question>();
    }

    private void HandleQuestionCreated(Question question)
    {
        filteredQuestions = new List<Question>();

        StateHasChanged();
    }

    [Inject]
    private NavigationManager? NavigationManager { get; set; }

    private void ApplyFilters()
    {
        filteredQuestions = GlobalVariables.AllQuestions.Where(q =>
            (string.IsNullOrEmpty(filterModel.Subject) || q.Subject.Contains(filterModel.Subject, StringComparison.OrdinalIgnoreCase)) &&
            (string.IsNullOrEmpty(filterModel.Tag) || q.Tag.Contains(filterModel.Tag, StringComparison.OrdinalIgnoreCase)) &&
            (string.IsNullOrEmpty(filterModel.Topic) || q.Topic.Contains(filterModel.Topic, StringComparison.OrdinalIgnoreCase)) &&
            (!filterModel.ShowMyQuestionsOnly || q.Owner == "Me") &&
            (filterModel.Date == null || q.Date.Date == filterModel.Date.Value.Date) &&
            (string.IsNullOrEmpty(filterModel.Type) || q.Type.Contains(filterModel.Type, StringComparison.OrdinalIgnoreCase)) &&
            (string.IsNullOrEmpty(filterModel.Level) || q.Level == filterModel.Level)
        ).ToList();
    }

    private void ClearFilters()
    {
        filterModel = new QuestionFilter();
        filteredQuestions = new List<Question>(GlobalVariables.AllQuestions);
    }

    private void EditQuestion(int questionId)
    {
        selectedQuestion = GlobalVariables.AllQuestions.FirstOrDefault(q => q.Id == questionId);
        ShowCreateQuestionModal = true;
    }

    private void DeleteQuestion(int questionId)
    {
        var question = GlobalVariables.AllQuestions.FirstOrDefault(q => q.Id == questionId);
        if (question != null)
        {
            GlobalVariables.AllQuestions.Remove(question);
            ApplyFilters();
        }
    }

